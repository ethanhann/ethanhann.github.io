root = true

# Keep Markdown prose one sentence per line. Stop RustRover's "Reformat Code"
# from reflowing paragraphs to the right margin, which makes diffs reflow whole
# paragraphs instead of single sentences.
[*.md]
max_line_length = off
ij_markdown_keep_line_breaks_inside_text_blocks = true
ij_markdown_wrap_text_if_long = false
